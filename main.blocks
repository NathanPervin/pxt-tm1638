<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="lrWk40u8+4(DaN?NHUeh" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="+joS@X5aqfwe7Ug*JK.n"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace TM1638 {" line1="" line2="    let strobe = DigitalPin.P0" line3="    let clock = DigitalPin.P1" line4="    let data = DigitalPin.P2" line5="" line6="    let led_status: boolean[] = [false, false, false, false, false, false, false, false]" line7="    let seven_segment_status: number[] = [0, 0, 0, 0, 0, 0, 0, 0]" line8="" line9="    let lastButtonState = 0" line10="    let button_functions: ((btn: number) =&gt; void)[] = []" line11="    let monitor_buttons_enable = false // true=monitor buttons, false=don't monitor buttons" line12="" line13="    const seven_segment_decoder_table: { [key: string]: number } = {" line14="        &quot;0&quot;: 0x3f," line15="        &quot;1&quot;: 0x06," line16="        &quot;2&quot;: 0x5b," line17="        &quot;3&quot;: 0x4f," line18="        &quot;4&quot;: 0x66," line19="        &quot;5&quot;: 0x6d," line20="        &quot;6&quot;: 0x7d," line21="        &quot;7&quot;: 0x07," line22="        &quot;8&quot;: 0x7f," line23="        &quot;9&quot;: 0x6f," line24="        &quot;A&quot;: 0x77," line25="        &quot;B&quot;: 0x7c," line26="        &quot;C&quot;: 0x39," line27="        &quot;D&quot;: 0x5e," line28="        &quot;E&quot;: 0x79," line29="        &quot;F&quot;: 0x71," line30="        &quot;G&quot;: 0x3d," line31="        &quot;H&quot;: 0x76," line32="        &quot;I&quot;: 0x06," line33="        &quot;J&quot;: 0x1e," line34="        &quot;L&quot;: 0x38," line35="        &quot;N&quot;: 0x54," line36="        &quot;O&quot;: 0x3f," line37="        &quot;P&quot;: 0x73," line38="        &quot;Q&quot;: 0x67," line39="        &quot;R&quot;: 0x50," line40="        &quot;S&quot;: 0x6d," line41="        &quot;T&quot;: 0x78," line42="        &quot;U&quot;: 0x3e," line43="        &quot;Y&quot;: 0x6e," line44="        &quot;Z&quot;: 0x5b," line45="        &quot; &quot;: 0x00," line46="        &quot;-&quot;: 0x40" line47="    }" line48="" line49="    export enum one_through_eight {" line50="        //%block=&quot;1&quot;" line51="        Digit1 = 1," line52="        //%block=&quot;2&quot;" line53="        Digit2 = 2," line54="        //%block=&quot;3&quot;" line55="        Digit3 = 3," line56="        //%block=&quot;4&quot;" line57="        Digit4 = 4," line58="        //%block=&quot;5&quot;" line59="        Digit5 = 5," line60="        //%block=&quot;6&quot;" line61="        Digit6 = 6," line62="        //%block=&quot;7&quot;" line63="        Digit7 = 7," line64="        //%block=&quot;8&quot;" line65="        Digit8 = 8" line66="    }" line67="" line68="    export enum button_poll_rate {" line69="        //% block=&quot;50 ms&quot;" line70="        Rate50 = 50," line71="        //% block=&quot;100 ms&quot;" line72="        Rate100 = 100," line73="        //% block=&quot;150 ms&quot;" line74="        Rate150 = 150," line75="        //% block=&quot;200 ms&quot;" line76="        Rate200 = 200" line77="    }" line78="" line79="    /**" line80="     * Converts input char to corresponding seven segment " line81="     * binary value, if the character is not found in the" line82="     * table such as &quot;M&quot; or &quot;X&quot;, the function will return as empty " line83="     * space (svn segment off). This is because some characters" line84="     * such as &quot;M&quot; and &quot;X&quot; cannot be represented in a seven" line85="     * segment display." line86="     */" line87="    function seven_segment_decoder(c: string): number {" line88="        if (seven_segment_decoder_table[c] != undefined) {" line89="            return seven_segment_decoder_table[c]" line90="        } else {" line91="            return 0x00" line92="        }" line93="    }" line94="" line95="    /* " line96="     * Replicates Arduino shiftOut function (with MSBFIRST option removed)," line97="     * sends out 8-bit number one bit at a time starting with the" line98="     * least significant bit" line99="     */" line100="    function shiftOut(dataPin: DigitalPin, clockPin: DigitalPin, value: number): void {" line101="        let bit: number" line102="" line103="        // loop through all 8 bits" line104="        for (let i = 0; i &lt; 8; i++) {" line105="" line106="            // right shift value by current bit" line107="            // being sent (determined by loop index)" line108="            // this places the bit that is being send in the " line109="            // LSB, then AND with binary 00000001 to mask" line110="            // out all other bits " line111="            bit = (value &gt;&gt; i) &amp; 0b1" line112="" line113="            pins.digitalWritePin(dataPin, bit)" line114="            pins.digitalWritePin(clockPin, 1)" line115="            pins.digitalWritePin(clockPin, 0)" line116="        }" line117="    }" line118="" line119="    /* " line120="     * Replicates Arduino shiftIn function (with MSBFIRST option removed)," line121="     * reads in 8-bit number one bit at a time starting with the" line122="     * least significant bit" line123="     */" line124="    function shiftIn(dataPin: DigitalPin, clockPin: DigitalPin): number {" line125="        let value = 0" line126="        for (let j = 0; j &lt; 8; j++) {" line127="            pins.digitalWritePin(clockPin, 1)" line128="" line129="            // shift read in bit status to the index " line130="            // of the current bit being read LSB first" line131="            // OR with other bits " line132="            value |= (pins.digitalReadPin(dataPin) &lt;&lt; j)" line133="            pins.digitalWritePin(clockPin, 0)" line134="        }" line135="        return value" line136="    }" line137="" line138="    /* " line139="     * Manufacturer provided method of sending a command to the TM1638" line140="     */" line141="    function sendCommand(cmd: number): void {" line142="        pins.digitalWritePin(strobe, 0)" line143="        shiftOut(data, clock, cmd)" line144="        pins.digitalWritePin(strobe, 1)" line145="    }" line146="" line147="    /* " line148="     * Manufacturer provided method of reading button status" line149="     */" line150="    function read_buttons(): number {" line151="        let buttons = 0" line152="        pins.digitalWritePin(strobe, 0)" line153="        shiftOut(data, clock, 0x42)" line154="" line155="        pins.setPull(data, PinPullMode.PullNone)" line156="" line157="        for (let k = 0; k &lt; 4; k++) {" line158="            let v = shiftIn(data, clock) &lt;&lt; k" line159="            buttons |= v" line160="        }" line161="" line162="        pins.digitalWritePin(strobe, 1)" line163="        return buttons" line164="    }" line165="" line166="    /**" line167="     * Allows the user to show a string on the 7-segment display " line168="     */" line169="    //%block" line170="    export function showString(input_text: string): void {" line171="        input_text = input_text.toUpperCase()" line172="        seven_segment_status = [0, 0, 0, 0, 0, 0, 0, 0]" line173="" line174="        // if the input string is above 8 chars in length, truncate down to 8 chars" line175="        if (input_text.length &gt; 8) {" line176="            input_text = input_text.slice(0, 8)" line177="        }" line178="" line179="        // loop through all inputted characters" line180="        for (let l = 0; l &lt; input_text.length; l++) {" line181="" line182="            // call decoder function to recieve the seven segment binary for" line183="            // the current letter" line184="            seven_segment_status[l] = seven_segment_decoder(input_text.charAt(l))" line185="" line186="        }" line187="" line188="        // display the sanitized input text on the seven segment displays" line189="        update_seven_segments()" line190="    }" line191="" line192="    /**" line193="     * Allows the user to set the status of the 8 LEDs" line194="     */" line195="    //% block=&quot;Turn ON/OFF LEDs $txt LED1 =$led0 LED2 =$led1 LED3 =$led2 LED4 =$led3 LED5 =$led4 LED6 =$led5 LED7 =$led6 LED8 =$led7&quot;" line196="    //% txt.shadow=&quot;&quot; led0.shadow=&quot;toggleOnOff&quot; led1.shadow=&quot;toggleOnOff&quot; led2.shadow=&quot;toggleOnOff&quot; led3.shadow=&quot;toggleOnOff&quot;" line197="    //% led4.shadow=&quot;toggleOnOff&quot; led5.shadow=&quot;toggleOnOff&quot; led6.shadow=&quot;toggleOnOff&quot; led7.shadow=&quot;toggleOnOff&quot;" line198="    //% led0.defl=false led1.defl=false led2.defl=false led3.defl=false" line199="    //% led4.defl=false led5.defl=false led6.defl=false led7.defl=false" line200="    export function setLEDs(" line201="        led0: boolean, led1: boolean, led2: boolean, led3: boolean," line202="        led4: boolean, led5: boolean, led6: boolean, led7: boolean" line203="    ): void {" line204="        led_status = [led0, led1, led2, led3, led4, led5, led6, led7]" line205="        update_LEDs()" line206="    }" line207="" line208="    /* " line209="     * Manufacturer provided method of reading button status" line210="     * modified to loop through a list of led status instead" line211="     * of setting an individual led at specified position" line212="     */" line213="    function update_LEDs(): void {" line214="" line215="        // loop through all 8 LEDs in led_status list" line216="        for (let m = 0; m &lt; 8; m++) {" line217="" line218="            shiftOut(data, clock, 0x44)" line219="            pins.digitalWritePin(strobe, 0)" line220="" line221="            // convert boolean to 1 or 0" line222="            // for current led" line223="            let led_state: number" line224="            if (led_status[m]) {" line225="                led_state = 1" line226="            } else {" line227="                led_state = 0" line228="            }" line229="" line230="            pins.digitalWritePin(strobe, 0)" line231="            shiftOut(data, clock, 0xC1 + (m &lt;&lt; 1))" line232="            shiftOut(data, clock, led_state)" line233="            pins.digitalWritePin(strobe, 1)" line234="        }" line235="    }" line236="" line237="    /* " line238="     * Manufacturer provided method of writing to seven segment displays" line239="     */" line240="    function update_seven_segments(): void {" line241="" line242="        pins.digitalWritePin(strobe, 0)" line243="        shiftOut(data, clock, 0x40)" line244="        pins.digitalWritePin(strobe, 1)" line245="" line246="        pins.digitalWritePin(strobe, 0)" line247="        shiftOut(data, clock, 0xC0)" line248="" line249="        for (let n = 0; n &lt; 8; n++) {" line250="" line251="            shiftOut(data, clock, seven_segment_status[n])" line252="            shiftOut(data, clock, led_status[n] ? 1 : 0)" line253="        }" line254="" line255="        pins.digitalWritePin(strobe, 1)" line256="    }" line257="" line258="    /* " line259="     * Manufacturer provided method of resetting the board" line260="     */" line261="    //% block=&quot;clear board&quot;" line262="    export function reset(): void {" line263="        sendCommand(0x40)" line264="        pins.digitalWritePin(strobe, 0)" line265="        shiftOut(data, clock, 0xC0)" line266="        for (let o = 0; o &lt; 16; o++) {" line267="            shiftOut(data, clock, 0x00)" line268="        }" line269="        pins.digitalWritePin(strobe, 1)" line270="" line271="        led_status = [false, false, false, false, false, false, false, false]" line272="        update_LEDs()" line273="    }" line274="" line275="    /* " line276="     * Manufacturer provided method of board setup" line277="     */" line278="    function setup(): void {" line279="        sendCommand(0x8F)" line280="        reset()" line281="    }" line282="" line283="    /**" line284="     * Allows the user to scroll through text." line285="     * Text can be any length so the user can display more than" line286="     * 8 characters" line287="     */" line288="    //% block=&quot;scroll text %text with speed %speed&quot;" line289="    //% speed.min=1 speed.max=10 speed.defl=5" line290="    export function scrollText(text: string, speed: number): void {" line291="" line292="        text = text.toUpperCase()" line293="" line294="        // convert 1 through 10 for input speed to a delay in ms" line295="        // start with 350 initial delay, subtract the 1-10 speed" line296="        // after scaling it to ms, each increase of speed value" line297="        // decreases the delay by 30 ms" line298="        let delay = 350 - (speed * 30)" line299="" line300="        // add spaces before and after the text" line301="        let padded_text = &quot;        &quot; + text + &quot;        &quot;" line302="" line303="        // loop through each 8-character slice in the padded_text" line304="        for (let p = 0; p &lt;= padded_text.length - 8; p++) {" line305="" line306="            // get the current 8-char text from the padded text" line307="            let current_text = padded_text.slice(p, p + 8)" line308="" line309="            // call existing show string function and" line310="            // delay for specified time before showing the" line311="            // next 8-char slice" line312="            showString(current_text)" line313="            basic.pause(delay)" line314="        }" line315="    }" line316="" line317="    /**" line318="     * Allows the user to enable the decimal point on a " line319="     * specific seven segment display (1 through 8)" line320="     */" line321="    //%block=&quot;turn on decimal point at digit %digit&quot;" line322="    //% digit.defl=TM1638.one_through_eight.Digit1" line323="    export function turnOnDecimalPoint(digit: one_through_eight): void {" line324="        let index = digit - 1" line325="" line326="        // decimal point of the seven segment is" line327="        // controlled by the 7th bit: 0b10000000 = 0x80" line328="        // so, OR existing seven segment value with a set 7th bit" line329="        seven_segment_status[index] |= 0x80" line330="        update_seven_segments()" line331="    }" line332="" line333="    /**" line334="     * Allows the user to start polling the button status" line335="     * User can select between 4 different polling rates" line336="     * which dictates generally how long the user must" line337="     * press and hold a button for an positive press reading" line338="     */" line339="    //% block=&quot;start checking buttons every %rate&quot;" line340="    //% rate.defl=TM1638.button_poll_rate.Rate50" line341="    export function startCheckingButtons(rate: button_poll_rate): void {" line342="" line343="        // if the buttons are already being checked and the" line344="        // function is called again, return to avoid two" line345="        // background subroutines" line346="        if (monitor_buttons_enable) return" line347="" line348="        // function was called while the buttons were not being " line349="        // checked so enable this flag to start checking the buttons" line350="        monitor_buttons_enable = true" line351="" line352="        // run in background block" line353="        control.inBackground(() =&gt; {" line354="" line355="            while (monitor_buttons_enable) {" line356="" line357="                // call function to get current button status" line358="                let current = read_buttons()" line359="" line360="                // loop through all 8 bits of current" line361="                // each bit represents the corresponding button status" line362="                for (let q = 0; q &lt; 8; q++) {" line363="" line364="                    // set all bits to 0 except current bit being checked" line365="                    let mask = 1 &lt;&lt; q" line366="" line367="                    // check that current button is pressed," line368="                    // ensure that the button state has changed since last recorded status " line369="                    // (otherwise holding the button would count as multiple presses)" line370="                    if ((current &amp; mask) &amp;&amp; !(lastButtonState &amp; mask)) {" line371="" line372="                        // check if the user has created a " line373="                        // function block for the current button that was pressed" line374="                        if (button_functions[q]) {" line375="" line376="                            // if the user has created the function block, call the function" line377="                            button_functions[q](q + 1)" line378="                        }" line379="                    }" line380="                }" line381="" line382="                // save the current button states and delay for specified time" line383="                lastButtonState = current" line384="                basic.pause(rate)" line385="            }" line386="        })" line387="    }" line388="" line389="    /*" line390="     * Allows the user to disable polling buttons" line391="     * Frees up TM1638 board I/O for other uses" line392="     */" line393="    //% block=&quot;stop checking buttons&quot;" line394="    export function stopCheckingButtons(): void {" line395="        monitor_buttons_enable = false" line396="    }" line397="" line398="    /*" line399="     * Allows the user to execute a function when a specific button" line400="     * is pressed" line401="     */" line402="    //% block=&quot;on button %btn pressed&quot;" line403="    //% btn.defl=TM1638.one_through_eight.Digit1" line404="    export function onButtonPressed(btn: one_through_eight, button_function: () =&gt; void): void {" line405="" line406="        // adds a reference to a function to button_functions as a list element" line407="        // with index corresponding to the button number" line408="        // ie. button 1 will call function in index position 0," line409="        // button 8 will call function in index position 7 " line410="        button_functions[btn - 1] = button_function" line411="    }" line412="" line413="    /*" line414="     * Must be placed before trying to use any other block" line415="     * ideally place in &quot;on start&quot;" line416="     */" line417="    //%block=&quot;initialize&quot;" line418="    export function initialize(): void {" line419="        basic.pause(50)" line420="        setup()" line421="        basic.pause(100)" line422="    }" line423="" line424="}" numlines="425"></mutation></block></statement></block></xml>