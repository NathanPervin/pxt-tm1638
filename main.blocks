<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="b%2(HvGOk%LrSM:W@1w2" x="55" y="54"><statement name="HANDLER"><block type="typescript_statement" id="zLQD^B4@HFFgC-Q.Fm6~"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace TM1638 {" line1="" line2="    let strobe = DigitalPin.P0" line3="    let clock = DigitalPin.P1" line4="    let data = DigitalPin.P2" line5="" line6="    let led_status: boolean[] = [false, false, false, false, false, false, false, false]" line7="    let seven_segment_status: number[] = [0, 0, 0, 0, 0, 0, 0, 0]" line8="" line9="    let lastButtonState = 0" line10="    let button_functions: ((btn: number) =&gt; void)[] = []" line11="    let monitor_buttons_enable = false // true=monitor buttons, false=don't monitor buttons" line12="" line13="    const seven_segment_decoder_table: { [key: string]: number } = {" line14="        &quot;0&quot;: 0x3f," line15="        &quot;1&quot;: 0x06," line16="        &quot;2&quot;: 0x5b," line17="        &quot;3&quot;: 0x4f," line18="        &quot;4&quot;: 0x66," line19="        &quot;5&quot;: 0x6d," line20="        &quot;6&quot;: 0x7d," line21="        &quot;7&quot;: 0x07," line22="        &quot;8&quot;: 0x7f," line23="        &quot;9&quot;: 0x6f," line24="        &quot;A&quot;: 0x77," line25="        &quot;B&quot;: 0x7c," line26="        &quot;C&quot;: 0x39," line27="        &quot;D&quot;: 0x5e," line28="        &quot;E&quot;: 0x79," line29="        &quot;F&quot;: 0x71," line30="        &quot;G&quot;: 0x3d," line31="        &quot;H&quot;: 0x76," line32="        &quot;I&quot;: 0x06," line33="        &quot;J&quot;: 0x1e," line34="        &quot;L&quot;: 0x38," line35="        &quot;N&quot;: 0x54," line36="        &quot;O&quot;: 0x3f," line37="        &quot;P&quot;: 0x73," line38="        &quot;Q&quot;: 0x67," line39="        &quot;R&quot;: 0x50," line40="        &quot;S&quot;: 0x6d," line41="        &quot;T&quot;: 0x78," line42="        &quot;U&quot;: 0x3e," line43="        &quot;Y&quot;: 0x6e," line44="        &quot;Z&quot;: 0x5b," line45="        &quot; &quot;: 0x00," line46="        &quot;-&quot;: 0x40" line47="    }" line48="" line49="    export enum one_through_eight {" line50="        //%block=&quot;1&quot;" line51="        Digit1 = 1," line52="        //%block=&quot;2&quot;" line53="        Digit2 = 2," line54="        //%block=&quot;3&quot;" line55="        Digit3 = 3," line56="        //%block=&quot;4&quot;" line57="        Digit4 = 4," line58="        //%block=&quot;5&quot;" line59="        Digit5 = 5," line60="        //%block=&quot;6&quot;" line61="        Digit6 = 6," line62="        //%block=&quot;7&quot;" line63="        Digit7 = 7," line64="        //%block=&quot;8&quot;" line65="        Digit8 = 8" line66="    }" line67="" line68="    export enum button_poll_rate {" line69="        //% block=&quot;50 ms&quot;" line70="        Rate50 = 50," line71="        //% block=&quot;100 ms&quot;" line72="        Rate100 = 100," line73="        //% block=&quot;150 ms&quot;" line74="        Rate150 = 150," line75="        //% block=&quot;200 ms&quot;" line76="        Rate200 = 200" line77="    }" line78="" line79="    export enum PinOptions {" line80="        //% block=&quot;P0=STB, P1=CLK, P2=DIO&quot;" line81="        Default," line82="        //% block=&quot;P16=STB, P15=CLK, P14=DIO&quot;" line83="        AlternateOne," line84="    }" line85="" line86="    /**" line87="     * Converts input char to corresponding seven segment " line88="     * binary value, if the character is not found in the" line89="     * table such as &quot;M&quot; or &quot;X&quot;, the function will return as empty " line90="     * space (svn segment off). This is because some characters" line91="     * such as &quot;M&quot; and &quot;X&quot; cannot be represented in a seven" line92="     * segment display." line93="     */" line94="    function seven_segment_decoder(c: string): number {" line95="        if (seven_segment_decoder_table[c] != undefined) {" line96="            return seven_segment_decoder_table[c]" line97="        } else {" line98="            return 0x00" line99="        }" line100="    }" line101="" line102="    /* " line103="     * Replicates Arduino shiftOut function (with MSBFIRST option removed)," line104="     * sends out 8-bit number one bit at a time starting with the" line105="     * least significant bit" line106="     */" line107="    function shiftOut(dataPin: DigitalPin, clockPin: DigitalPin, value: number): void {" line108="        let bit: number" line109="" line110="        // loop through all 8 bits" line111="        for (let i = 0; i &lt; 8; i++) {" line112="" line113="            // right shift value by current bit" line114="            // being sent (determined by loop index)" line115="            // this places the bit that is being send in the " line116="            // LSB, then AND with binary 00000001 to mask" line117="            // out all other bits " line118="            bit = (value &gt;&gt; i) &amp; 0b1" line119="" line120="            pins.digitalWritePin(dataPin, bit)" line121="            pins.digitalWritePin(clockPin, 1)" line122="            pins.digitalWritePin(clockPin, 0)" line123="        }" line124="    }" line125="" line126="    /* " line127="     * Replicates Arduino shiftIn function (with MSBFIRST option removed)," line128="     * reads in 8-bit number one bit at a time starting with the" line129="     * least significant bit" line130="     */" line131="    function shiftIn(dataPin: DigitalPin, clockPin: DigitalPin): number {" line132="        let value = 0" line133="        for (let j = 0; j &lt; 8; j++) {" line134="            pins.digitalWritePin(clockPin, 1)" line135="" line136="            // shift read in bit status to the index " line137="            // of the current bit being read LSB first" line138="            // OR with other bits " line139="            value |= (pins.digitalReadPin(dataPin) &lt;&lt; j)" line140="            pins.digitalWritePin(clockPin, 0)" line141="        }" line142="        return value" line143="    }" line144="" line145="    /* " line146="     * Manufacturer provided method of sending a command to the TM1638" line147="     */" line148="    function sendCommand(cmd: number): void {" line149="        pins.digitalWritePin(strobe, 0)" line150="        shiftOut(data, clock, cmd)" line151="        pins.digitalWritePin(strobe, 1)" line152="    }" line153="" line154="    /* " line155="     * Manufacturer provided method of reading button status" line156="     */" line157="    function read_buttons(): number {" line158="        let buttons = 0" line159="        pins.digitalWritePin(strobe, 0)" line160="        shiftOut(data, clock, 0x42)" line161="" line162="        pins.setPull(data, PinPullMode.PullNone)" line163="" line164="        for (let k = 0; k &lt; 4; k++) {" line165="            let v = shiftIn(data, clock) &lt;&lt; k" line166="            buttons |= v" line167="        }" line168="" line169="        pins.digitalWritePin(strobe, 1)" line170="        return buttons" line171="    }" line172="" line173="    /**" line174="     * Allows the user to show a string on the 7-segment display " line175="     */" line176="    //%block" line177="    export function showString(input_text: string): void {" line178="        input_text = input_text.toUpperCase()" line179="        seven_segment_status = [0, 0, 0, 0, 0, 0, 0, 0]" line180="" line181="        // if the input string is above 8 chars in length, truncate down to 8 chars" line182="        if (input_text.length &gt; 8) {" line183="            input_text = input_text.slice(0, 8)" line184="        }" line185="" line186="        // loop through all inputted characters" line187="        for (let l = 0; l &lt; input_text.length; l++) {" line188="" line189="            // call decoder function to recieve the seven segment binary for" line190="            // the current letter" line191="            seven_segment_status[l] = seven_segment_decoder(input_text.charAt(l))" line192="" line193="        }" line194="" line195="        // display the sanitized input text on the seven segment displays" line196="        update_seven_segments()" line197="    }" line198="" line199="    /**" line200="     * Allows the user to set the status of the 8 LEDs" line201="     */" line202="    //% block=&quot;Turn ON/OFF LEDs $txt LED1 =$led0 LED2 =$led1 LED3 =$led2 LED4 =$led3 LED5 =$led4 LED6 =$led5 LED7 =$led6 LED8 =$led7&quot;" line203="    //% txt.shadow=&quot;&quot; led0.shadow=&quot;toggleOnOff&quot; led1.shadow=&quot;toggleOnOff&quot; led2.shadow=&quot;toggleOnOff&quot; led3.shadow=&quot;toggleOnOff&quot;" line204="    //% led4.shadow=&quot;toggleOnOff&quot; led5.shadow=&quot;toggleOnOff&quot; led6.shadow=&quot;toggleOnOff&quot; led7.shadow=&quot;toggleOnOff&quot;" line205="    //% led0.defl=false led1.defl=false led2.defl=false led3.defl=false" line206="    //% led4.defl=false led5.defl=false led6.defl=false led7.defl=false" line207="    export function setLEDs(" line208="        led0: boolean, led1: boolean, led2: boolean, led3: boolean," line209="        led4: boolean, led5: boolean, led6: boolean, led7: boolean" line210="    ): void {" line211="        led_status = [led0, led1, led2, led3, led4, led5, led6, led7]" line212="        update_LEDs()" line213="    }" line214="" line215="    /* " line216="     * Manufacturer provided method of reading button status" line217="     * modified to loop through a list of led status instead" line218="     * of setting an individual led at specified position" line219="     */" line220="    function update_LEDs(): void {" line221="" line222="        // loop through all 8 LEDs in led_status list" line223="        for (let m = 0; m &lt; 8; m++) {" line224="" line225="            shiftOut(data, clock, 0x44)" line226="            pins.digitalWritePin(strobe, 0)" line227="" line228="            // convert boolean to 1 or 0" line229="            // for current led" line230="            let led_state: number" line231="            if (led_status[m]) {" line232="                led_state = 1" line233="            } else {" line234="                led_state = 0" line235="            }" line236="" line237="            pins.digitalWritePin(strobe, 0)" line238="            shiftOut(data, clock, 0xC1 + (m &lt;&lt; 1))" line239="            shiftOut(data, clock, led_state)" line240="            pins.digitalWritePin(strobe, 1)" line241="        }" line242="    }" line243="" line244="    /* " line245="     * Manufacturer provided method of writing to seven segment displays" line246="     */" line247="    function update_seven_segments(): void {" line248="" line249="        pins.digitalWritePin(strobe, 0)" line250="        shiftOut(data, clock, 0x40)" line251="        pins.digitalWritePin(strobe, 1)" line252="" line253="        pins.digitalWritePin(strobe, 0)" line254="        shiftOut(data, clock, 0xC0)" line255="" line256="        for (let n = 0; n &lt; 8; n++) {" line257="" line258="            shiftOut(data, clock, seven_segment_status[n])" line259="            shiftOut(data, clock, led_status[n] ? 1 : 0)" line260="        }" line261="" line262="        pins.digitalWritePin(strobe, 1)" line263="    }" line264="" line265="    /* " line266="     * Manufacturer provided method of resetting the board" line267="     */" line268="    //% block=&quot;clear board&quot;" line269="    export function reset(): void {" line270="        sendCommand(0x40)" line271="        pins.digitalWritePin(strobe, 0)" line272="        shiftOut(data, clock, 0xC0)" line273="        for (let o = 0; o &lt; 16; o++) {" line274="            shiftOut(data, clock, 0x00)" line275="        }" line276="        pins.digitalWritePin(strobe, 1)" line277="" line278="        led_status = [false, false, false, false, false, false, false, false]" line279="        update_LEDs()" line280="    }" line281="" line282="    /* " line283="     * Manufacturer provided method of board setup" line284="     */" line285="    function setup(): void {" line286="        sendCommand(0x8F)" line287="        reset()" line288="    }" line289="" line290="    /**" line291="     * Allows the user to scroll through text." line292="     * Text can be any length so the user can display more than" line293="     * 8 characters" line294="     */" line295="    //% block=&quot;scroll text %text with speed %speed&quot;" line296="    //% speed.min=1 speed.max=10 speed.defl=5" line297="    export function scrollText(text: string, speed: number): void {" line298="" line299="        text = text.toUpperCase()" line300="" line301="        // convert 1 through 10 for input speed to a delay in ms" line302="        // start with 350 initial delay, subtract the 1-10 speed" line303="        // after scaling it to ms, each increase of speed value" line304="        // decreases the delay by 30 ms" line305="        let delay = 350 - (speed * 30)" line306="" line307="        // add spaces before and after the text" line308="        let padded_text = &quot;        &quot; + text + &quot;        &quot;" line309="" line310="        // loop through each 8-character slice in the padded_text" line311="        for (let p = 0; p &lt;= padded_text.length - 8; p++) {" line312="" line313="            // get the current 8-char text from the padded text" line314="            let current_text = padded_text.slice(p, p + 8)" line315="" line316="            // call existing show string function and" line317="            // delay for specified time before showing the" line318="            // next 8-char slice" line319="            showString(current_text)" line320="            basic.pause(delay)" line321="        }" line322="    }" line323="" line324="    /**" line325="     * Allows the user to enable the decimal point on a " line326="     * specific seven segment display (1 through 8)" line327="     */" line328="    //%block=&quot;turn on decimal point at digit %digit&quot;" line329="    //% digit.defl=TM1638.one_through_eight.Digit1" line330="    export function turnOnDecimalPoint(digit: one_through_eight): void {" line331="        let index = digit - 1" line332="" line333="        // decimal point of the seven segment is" line334="        // controlled by the 7th bit: 0b10000000 = 0x80" line335="        // so, OR existing seven segment value with a set 7th bit" line336="        seven_segment_status[index] |= 0x80" line337="        update_seven_segments()" line338="    }" line339="" line340="    /**" line341="     * Allows the user to start polling the button status" line342="     * User can select between 4 different polling rates" line343="     * which dictates generally how long the user must" line344="     * press and hold a button for an positive press reading" line345="     */" line346="    //% block=&quot;start checking buttons every %rate&quot;" line347="    //% rate.defl=TM1638.button_poll_rate.Rate50" line348="    export function startCheckingButtons(rate: button_poll_rate): void {" line349="" line350="        // if the buttons are already being checked and the" line351="        // function is called again, return to avoid two" line352="        // background subroutines" line353="        if (monitor_buttons_enable) return" line354="" line355="        // function was called while the buttons were not being " line356="        // checked so enable this flag to start checking the buttons" line357="        monitor_buttons_enable = true" line358="" line359="        // run in background block" line360="        control.inBackground(() =&gt; {" line361="" line362="            while (monitor_buttons_enable) {" line363="" line364="                // call function to get current button status" line365="                let current = read_buttons()" line366="" line367="                // loop through all 8 bits of current" line368="                // each bit represents the corresponding button status" line369="                for (let q = 0; q &lt; 8; q++) {" line370="" line371="                    // set all bits to 0 except current bit being checked" line372="                    let mask = 1 &lt;&lt; q" line373="" line374="                    // check that current button is pressed," line375="                    // ensure that the button state has changed since last recorded status " line376="                    // (otherwise holding the button would count as multiple presses)" line377="                    if ((current &amp; mask) &amp;&amp; !(lastButtonState &amp; mask)) {" line378="" line379="                        // check if the user has created a " line380="                        // function block for the current button that was pressed" line381="                        if (button_functions[q]) {" line382="" line383="                            // if the user has created the function block, call the function" line384="                            button_functions[q](q + 1)" line385="                        }" line386="                    }" line387="                }" line388="" line389="                // save the current button states and delay for specified time" line390="                lastButtonState = current" line391="                basic.pause(rate)" line392="            }" line393="        })" line394="    }" line395="" line396="    /*" line397="     * Allows the user to disable polling buttons" line398="     * Frees up TM1638 board I/O for other uses" line399="     */" line400="    //% block=&quot;stop checking buttons&quot;" line401="    export function stopCheckingButtons(): void {" line402="        monitor_buttons_enable = false" line403="    }" line404="" line405="    /*" line406="     * Allows the user to execute a function when a specific button" line407="     * is pressed" line408="     */" line409="    //% block=&quot;on button %btn pressed&quot;" line410="    //% btn.defl=TM1638.one_through_eight.Digit1" line411="    export function onButtonPressed(btn: one_through_eight, button_function: () =&gt; void): void {" line412="" line413="        // adds a reference to a function to button_functions as a list element" line414="        // with index corresponding to the button number" line415="        // ie. button 1 will call function in index position 0," line416="        // button 8 will call function in index position 7 " line417="        button_functions[btn - 1] = button_function" line418="    }" line419="" line420="    /**" line421="     * Allows the user to choose between using P0,P1, and P2" line422="     * or P16, P15, and P14" line423="     */" line424="    //% block=&quot;use pins %pins&quot;" line425="    export function choosePinOption(pins: PinOptions): void {" line426="        if (pins == PinOptions.Default) {" line427="            strobe = DigitalPin.P0" line428="            clock = DigitalPin.P1" line429="            data = DigitalPin.P2" line430="        } else {" line431="            strobe = DigitalPin.P16" line432="            clock = DigitalPin.P15" line433="            data = DigitalPin.P14" line434="        }" line435="" line436="        initialize()" line437="    }" line438="" line439="    /*" line440="     * Must be placed before trying to use any other block" line441="     * ideally place in &quot;on start&quot;" line442="     */" line443="    //%block=&quot;initialize&quot;" line444="    export function initialize(): void {" line445="        basic.pause(50)" line446="        setup()" line447="        basic.pause(100)" line448="    }" line449="" line450="}" numlines="451"></mutation></block></statement></block></xml>