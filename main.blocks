<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="device_button_event" id="aFH-#w/0ALEyuOMwx.?y" x="-32" y="-271"><field name="NAME">Button.A</field><statement name="HANDLER"><block type="TM1638_choosePinOption" id="[;96McG8xp~P-(E6.@Gg"><field name="pins">TM1638.PinOptions.AlternateFour</field><next><block type="TM1638_setBrightness" id="qrkL6J[s+?dz},S_FdqP"><value name="level"><shadow type="math_number_minmax" id="Gp5!1Lpvt,xo.R6}QjwM"><mutation min="0" max="7" precision="0"></mutation><field name="SLIDER">7</field></shadow></value><next><block type="TM1638_scrollText" id="MCt_%nkV5m*rtFUCuN;O"><value name="text"><shadow type="text" id="{RH)=(8jZ0~5*]qHu.g7"><field name="TEXT">test0123456</field></shadow></value><value name="speed"><shadow type="math_number_minmax" id="dvTol[h-d;azF$JD0FQo"><mutation min="1" max="10" precision="0"></mutation><field name="SLIDER">5</field></shadow></value></block></next></block></next></block></statement></block><block type="pxt-on-start" id="XW+gUSqkaankC*szN/N`" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="^%!j#6T/l#`;do(h)Y-?"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace TM1638 {" line1="" line2="    let strobe = DigitalPin.P0" line3="    let clock = DigitalPin.P1" line4="    let data = DigitalPin.P2" line5="" line6="    let led_status: boolean[] = [false, false, false, false, false, false, false, false]" line7="    let seven_segment_status: number[] = [0, 0, 0, 0, 0, 0, 0, 0]" line8="" line9="    let lastButtonState = 0" line10="    let button_functions: ((btn: number) =&gt; void)[] = []" line11="    let monitor_buttons_enable = false // true=monitor buttons, false=don't monitor buttons" line12="" line13="    const seven_segment_decoder_table: { [key: string]: number } = {" line14="        &quot;0&quot;: 0x3f," line15="        &quot;1&quot;: 0x06," line16="        &quot;2&quot;: 0x5b," line17="        &quot;3&quot;: 0x4f," line18="        &quot;4&quot;: 0x66," line19="        &quot;5&quot;: 0x6d," line20="        &quot;6&quot;: 0x7d," line21="        &quot;7&quot;: 0x07," line22="        &quot;8&quot;: 0x7f," line23="        &quot;9&quot;: 0x6f," line24="        &quot;A&quot;: 0x77," line25="        &quot;B&quot;: 0x7c," line26="        &quot;C&quot;: 0x39," line27="        &quot;D&quot;: 0x5e," line28="        &quot;E&quot;: 0x79," line29="        &quot;F&quot;: 0x71," line30="        &quot;G&quot;: 0x3d," line31="        &quot;H&quot;: 0x76," line32="        &quot;I&quot;: 0x06," line33="        &quot;J&quot;: 0x1e," line34="        &quot;L&quot;: 0x38," line35="        &quot;N&quot;: 0x54," line36="        &quot;O&quot;: 0x3f," line37="        &quot;P&quot;: 0x73," line38="        &quot;Q&quot;: 0x67," line39="        &quot;R&quot;: 0x50," line40="        &quot;S&quot;: 0x6d," line41="        &quot;T&quot;: 0x78," line42="        &quot;U&quot;: 0x3e," line43="        &quot;Y&quot;: 0x6e," line44="        &quot;Z&quot;: 0x5b," line45="        &quot; &quot;: 0x00," line46="        &quot;-&quot;: 0x40" line47="    }" line48="" line49="    export enum one_through_eight {" line50="        //%block=&quot;1&quot;" line51="        Digit1 = 1," line52="        //%block=&quot;2&quot;" line53="        Digit2 = 2," line54="        //%block=&quot;3&quot;" line55="        Digit3 = 3," line56="        //%block=&quot;4&quot;" line57="        Digit4 = 4," line58="        //%block=&quot;5&quot;" line59="        Digit5 = 5," line60="        //%block=&quot;6&quot;" line61="        Digit6 = 6," line62="        //%block=&quot;7&quot;" line63="        Digit7 = 7," line64="        //%block=&quot;8&quot;" line65="        Digit8 = 8" line66="    }" line67="" line68="    export enum button_poll_rate {" line69="        //% block=&quot;50 ms&quot;" line70="        Rate50 = 50," line71="        //% block=&quot;100 ms&quot;" line72="        Rate100 = 100," line73="        //% block=&quot;150 ms&quot;" line74="        Rate150 = 150," line75="        //% block=&quot;200 ms&quot;" line76="        Rate200 = 200" line77="    }" line78="" line79="    export enum PinOptions {" line80="        //% block=&quot;P0=STB, P1=CLK, P2=DIO&quot;" line81="        Default," line82="        //% block=&quot;P16=STB, P15=CLK, P14=DIO&quot;" line83="        AlternateOne," line84="        //% block=&quot;P16=STB, P8=CLK, P2=DIO&quot;" line85="        AlternateTwo," line86="        //% block=&quot;P16=STB, P8=CLK, P1=DIO&quot;" line87="        AlternateThree," line88="        //% block=&quot;P16=STB, P8=CLK, P0=DIO&quot;" line89="        AlternateFour" line90="    }" line91="" line92="    /**" line93="     * Converts input char to corresponding seven segment " line94="     * binary value, if the character is not found in the" line95="     * table such as &quot;M&quot; or &quot;X&quot;, the function will return as empty " line96="     * space (svn segment off). This is because some characters" line97="     * such as &quot;M&quot; and &quot;X&quot; cannot be represented in a seven" line98="     * segment display." line99="     */" line100="    function seven_segment_decoder(c: string): number {" line101="        if (seven_segment_decoder_table[c] != undefined) {" line102="            return seven_segment_decoder_table[c]" line103="        } else {" line104="            return 0x00" line105="        }" line106="    }" line107="" line108="    /* " line109="     * Replicates Arduino shiftOut function (with MSBFIRST option removed)," line110="     * sends out 8-bit number one bit at a time starting with the" line111="     * least significant bit" line112="     */" line113="    function shiftOut(dataPin: DigitalPin, clockPin: DigitalPin, value: number): void {" line114="        let bit: number" line115="" line116="        // loop through all 8 bits" line117="        for (let i = 0; i &lt; 8; i++) {" line118="" line119="            // right shift value by current bit" line120="            // being sent (determined by loop index)" line121="            // this places the bit that is being send in the " line122="            // LSB, then AND with binary 00000001 to mask" line123="            // out all other bits " line124="            bit = (value &gt;&gt; i) &amp; 0b1" line125="" line126="            pins.digitalWritePin(dataPin, bit)" line127="            pins.digitalWritePin(clockPin, 1)" line128="            pins.digitalWritePin(clockPin, 0)" line129="        }" line130="    }" line131="" line132="    /* " line133="     * Replicates Arduino shiftIn function (with MSBFIRST option removed)," line134="     * reads in 8-bit number one bit at a time starting with the" line135="     * least significant bit" line136="     */" line137="    function shiftIn(dataPin: DigitalPin, clockPin: DigitalPin): number {" line138="        let value = 0" line139="        for (let j = 0; j &lt; 8; j++) {" line140="            pins.digitalWritePin(clockPin, 1)" line141="" line142="            // shift read in bit status to the index " line143="            // of the current bit being read LSB first" line144="            // OR with other bits " line145="            value |= (pins.digitalReadPin(dataPin) &lt;&lt; j)" line146="            pins.digitalWritePin(clockPin, 0)" line147="        }" line148="        return value" line149="    }" line150="" line151="    /* " line152="     * Manufacturer provided method of sending a command to the TM1638" line153="     */" line154="    function sendCommand(cmd: number): void {" line155="        pins.digitalWritePin(strobe, 0)" line156="        shiftOut(data, clock, cmd)" line157="        pins.digitalWritePin(strobe, 1)" line158="    }" line159="" line160="    /* " line161="     * Manufacturer provided method of reading button status" line162="     */" line163="    function read_buttons(): number {" line164="        let buttons = 0" line165="        pins.digitalWritePin(strobe, 0)" line166="        shiftOut(data, clock, 0x42)" line167="" line168="        pins.setPull(data, PinPullMode.PullNone)" line169="" line170="        for (let k = 0; k &lt; 4; k++) {" line171="            let v = shiftIn(data, clock) &lt;&lt; k" line172="            buttons |= v" line173="        }" line174="" line175="        pins.digitalWritePin(strobe, 1)" line176="        return buttons" line177="    }" line178="" line179="    /**" line180="     * Allows the user to show a string on the 7-segment display " line181="     */" line182="    //%block" line183="    export function showString(input_text: string): void {" line184="        input_text = input_text.toUpperCase()" line185="        seven_segment_status = [0, 0, 0, 0, 0, 0, 0, 0]" line186="" line187="        // if the input string is above 8 chars in length, truncate down to 8 chars" line188="        if (input_text.length &gt; 8) {" line189="            input_text = input_text.slice(0, 8)" line190="        }" line191="" line192="        // loop through all inputted characters" line193="        for (let l = 0; l &lt; input_text.length; l++) {" line194="" line195="            // call decoder function to recieve the seven segment binary for" line196="            // the current letter" line197="            seven_segment_status[l] = seven_segment_decoder(input_text.charAt(l))" line198="" line199="        }" line200="" line201="        // display the sanitized input text on the seven segment displays" line202="        update_seven_segments()" line203="    }" line204="" line205="    /**" line206="     * Allows the user to set the status of the 8 LEDs" line207="     */" line208="    //% block=&quot;Turn ON/OFF LEDs $txt LED1 =$led0 LED2 =$led1 LED3 =$led2 LED4 =$led3 LED5 =$led4 LED6 =$led5 LED7 =$led6 LED8 =$led7&quot;" line209="    //% txt.shadow=&quot;&quot; led0.shadow=&quot;toggleOnOff&quot; led1.shadow=&quot;toggleOnOff&quot; led2.shadow=&quot;toggleOnOff&quot; led3.shadow=&quot;toggleOnOff&quot;" line210="    //% led4.shadow=&quot;toggleOnOff&quot; led5.shadow=&quot;toggleOnOff&quot; led6.shadow=&quot;toggleOnOff&quot; led7.shadow=&quot;toggleOnOff&quot;" line211="    //% led0.defl=false led1.defl=false led2.defl=false led3.defl=false" line212="    //% led4.defl=false led5.defl=false led6.defl=false led7.defl=false" line213="    export function setLEDs(" line214="        led0: boolean, led1: boolean, led2: boolean, led3: boolean," line215="        led4: boolean, led5: boolean, led6: boolean, led7: boolean" line216="    ): void {" line217="        led_status = [led0, led1, led2, led3, led4, led5, led6, led7]" line218="        update_LEDs()" line219="    }" line220="" line221="    /* " line222="     * Manufacturer provided method of reading button status" line223="     * modified to loop through a list of led status instead" line224="     * of setting an individual led at specified position" line225="     */" line226="    function update_LEDs(): void {" line227="" line228="        // loop through all 8 LEDs in led_status list" line229="        for (let m = 0; m &lt; 8; m++) {" line230="" line231="            shiftOut(data, clock, 0x44)" line232="            pins.digitalWritePin(strobe, 0)" line233="" line234="            // convert boolean to 1 or 0" line235="            // for current led" line236="            let led_state: number" line237="            if (led_status[m]) {" line238="                led_state = 1" line239="            } else {" line240="                led_state = 0" line241="            }" line242="" line243="            pins.digitalWritePin(strobe, 0)" line244="            shiftOut(data, clock, 0xC1 + (m &lt;&lt; 1))" line245="            shiftOut(data, clock, led_state)" line246="            pins.digitalWritePin(strobe, 1)" line247="        }" line248="    }" line249="" line250="    /* " line251="     * Manufacturer provided method of writing to seven segment displays" line252="     */" line253="    function update_seven_segments(): void {" line254="" line255="        pins.digitalWritePin(strobe, 0)" line256="        shiftOut(data, clock, 0x40)" line257="        pins.digitalWritePin(strobe, 1)" line258="" line259="        pins.digitalWritePin(strobe, 0)" line260="        shiftOut(data, clock, 0xC0)" line261="" line262="        for (let n = 0; n &lt; 8; n++) {" line263="" line264="            shiftOut(data, clock, seven_segment_status[n])" line265="            shiftOut(data, clock, led_status[n] ? 1 : 0)" line266="        }" line267="" line268="        pins.digitalWritePin(strobe, 1)" line269="    }" line270="" line271="    /* " line272="     * Manufacturer provided method of resetting the board" line273="     */" line274="    //% block=&quot;clear board&quot;" line275="    export function reset(): void {" line276="        sendCommand(0x40)" line277="        pins.digitalWritePin(strobe, 0)" line278="        shiftOut(data, clock, 0xC0)" line279="        for (let o = 0; o &lt; 16; o++) {" line280="            shiftOut(data, clock, 0x00)" line281="        }" line282="        pins.digitalWritePin(strobe, 1)" line283="" line284="        led_status = [false, false, false, false, false, false, false, false]" line285="        update_LEDs()" line286="    }" line287="" line288="    /* " line289="     * Manufacturer provided method of board setup" line290="     */" line291="    function setup(): void {" line292="        sendCommand(0x8F)" line293="        reset()" line294="    }" line295="" line296="    /**" line297="     * Allows the user to scroll through text." line298="     * Text can be any length so the user can display more than" line299="     * 8 characters" line300="     */" line301="    //% block=&quot;scroll text %text with speed %speed&quot;" line302="    //% speed.min=1 speed.max=10 speed.defl=5" line303="    export function scrollText(text: string, speed: number): void {" line304="" line305="        text = text.toUpperCase()" line306="" line307="        // convert 1 through 10 for input speed to a delay in ms" line308="        // start with 350 initial delay, subtract the 1-10 speed" line309="        // after scaling it to ms, each increase of speed value" line310="        // decreases the delay by 30 ms" line311="        let delay = 350 - (speed * 30)" line312="" line313="        // add spaces before and after the text" line314="        let padded_text = &quot;        &quot; + text + &quot;        &quot;" line315="" line316="        // loop through each 8-character slice in the padded_text" line317="        for (let p = 0; p &lt;= padded_text.length - 8; p++) {" line318="" line319="            // get the current 8-char text from the padded text" line320="            let current_text = padded_text.slice(p, p + 8)" line321="" line322="            // call existing show string function and" line323="            // delay for specified time before showing the" line324="            // next 8-char slice" line325="            showString(current_text)" line326="            basic.pause(delay)" line327="        }" line328="    }" line329="" line330="    /**" line331="     * Allows the user to enable the decimal point on a " line332="     * specific seven segment display (1 through 8)" line333="     */" line334="    //%block=&quot;turn on decimal point at digit %digit&quot;" line335="    //% digit.defl=TM1638.one_through_eight.Digit1" line336="    export function turnOnDecimalPoint(digit: one_through_eight): void {" line337="        let index = digit - 1" line338="" line339="        // decimal point of the seven segment is" line340="        // controlled by the 7th bit: 0b10000000 = 0x80" line341="        // so, OR existing seven segment value with a set 7th bit" line342="        seven_segment_status[index] |= 0x80" line343="        update_seven_segments()" line344="    }" line345="" line346="    /**" line347="     * Allows the user to start polling the button status" line348="     * User can select between 4 different polling rates" line349="     * which dictates generally how long the user must" line350="     * press and hold a button for an positive press reading" line351="     */" line352="    //% block=&quot;start checking buttons every %rate&quot;" line353="    //% rate.defl=TM1638.button_poll_rate.Rate50" line354="    export function startCheckingButtons(rate: button_poll_rate): void {" line355="" line356="        // if the buttons are already being checked and the" line357="        // function is called again, return to avoid two" line358="        // background subroutines" line359="        if (monitor_buttons_enable) return" line360="" line361="        // function was called while the buttons were not being " line362="        // checked so enable this flag to start checking the buttons" line363="        monitor_buttons_enable = true" line364="" line365="        // run in background block" line366="        control.inBackground(() =&gt; {" line367="" line368="            while (monitor_buttons_enable) {" line369="" line370="                // call function to get current button status" line371="                let current = read_buttons()" line372="" line373="                // loop through all 8 bits of current" line374="                // each bit represents the corresponding button status" line375="                for (let q = 0; q &lt; 8; q++) {" line376="" line377="                    // set all bits to 0 except current bit being checked" line378="                    let mask = 1 &lt;&lt; q" line379="" line380="                    // check that current button is pressed," line381="                    // ensure that the button state has changed since last recorded status " line382="                    // (otherwise holding the button would count as multiple presses)" line383="                    if ((current &amp; mask) &amp;&amp; !(lastButtonState &amp; mask)) {" line384="" line385="                        // check if the user has created a " line386="                        // function block for the current button that was pressed" line387="                        if (button_functions[q]) {" line388="" line389="                            // if the user has created the function block, call the function" line390="                            button_functions[q](q + 1)" line391="                        }" line392="                    }" line393="                }" line394="" line395="                // save the current button states and delay for specified time" line396="                lastButtonState = current" line397="                basic.pause(rate)" line398="            }" line399="        })" line400="    }" line401="" line402="    /*" line403="     * Allows the user to disable polling buttons" line404="     * Frees up TM1638 board I/O for other uses" line405="     */" line406="    //% block=&quot;stop checking buttons&quot;" line407="    export function stopCheckingButtons(): void {" line408="        monitor_buttons_enable = false" line409="    }" line410="" line411="    /*" line412="     * Allows the user to execute a function when a specific button" line413="     * is pressed" line414="     */" line415="    //% block=&quot;on button %btn pressed&quot;" line416="    //% btn.defl=TM1638.one_through_eight.Digit1" line417="    export function onButtonPressed(btn: one_through_eight, button_function: () =&gt; void): void {" line418="" line419="        // adds a reference to a function to button_functions as a list element" line420="        // with index corresponding to the button number" line421="        // ie. button 1 will call function in index position 0," line422="        // button 8 will call function in index position 7 " line423="        button_functions[btn - 1] = button_function" line424="    }" line425="" line426="    /**" line427="     * Allows the user to choose between using P0,P1, and P2" line428="     * or P16, P15, and P14" line429="     */" line430="    //% block=&quot;use pins %pins&quot;" line431="    export function choosePinOption(pins: PinOptions): void {" line432="        if (pins == PinOptions.Default) {" line433="            strobe = DigitalPin.P0" line434="            clock = DigitalPin.P1" line435="            data = DigitalPin.P2" line436="        } else if (pins == PinOptions.AlternateOne) {" line437="            strobe = DigitalPin.P16" line438="            clock = DigitalPin.P15" line439="            data = DigitalPin.P14" line440="        }" line441="        else if (pins == PinOptions.AlternateTwo) {" line442="            strobe = DigitalPin.P16" line443="            clock = DigitalPin.P8" line444="            data = DigitalPin.P2" line445="        }" line446="        else if (pins == PinOptions.AlternateThree) {" line447="            strobe = DigitalPin.P16" line448="            clock = DigitalPin.P8" line449="            data = DigitalPin.P1" line450="        }" line451="        else {" line452="            strobe = DigitalPin.P16" line453="            clock = DigitalPin.P8" line454="            data = DigitalPin.P0" line455="        }" line456="" line457="        initialize()" line458="    }" line459="" line460="    /*" line461="     * Allows the user to set the brightness of the board" line462="     */ " line463="    //% block=&quot;set brightness to %level&quot;" line464="    //% level.min=0 level.max=7" line465="    export function setBrightness(level: number): void {" line466="        sendCommand(0x88 | level)" line467="    }" line468="" line469="    /*" line470="     * Must be placed before trying to use any other block" line471="     * ideally place in &quot;on start&quot;" line472="     */" line473="    //%block=&quot;initialize&quot;" line474="    export function initialize(): void {" line475="        basic.pause(50)" line476="        setup()" line477="        basic.pause(100)" line478="    }" line479="" line480="}" numlines="481"></mutation></block></statement></block></xml>