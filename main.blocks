<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="$`O%V6INfELwsQd=Oegh" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="98_yKz30D%be]rZuJmtW"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace TM1638 {" line1="" line2="    let strobe = DigitalPin.P0" line3="    let clock = DigitalPin.P1" line4="    let data = DigitalPin.P2" line5="" line6="    let led_status: boolean[] = [false, false, false, false, false, false, false, false]" line7="    let seven_segment_status: number[] = [0, 0, 0, 0, 0, 0, 0, 0]" line8="" line9="    let lastButtonState = 0" line10="    let button_functions: ((btn: number) =&gt; void)[] = []" line11="    let monitor_buttons_enable = false // true=monitor buttons, false=don't monitor buttons" line12="" line13="    let button_poll_rate = 50 // ms" line14="" line15="    const seven_segment_decoder_table: { [key: string]: number } = {" line16="        &quot;0&quot;: 0x3f," line17="        &quot;1&quot;: 0x06," line18="        &quot;2&quot;: 0x5b," line19="        &quot;3&quot;: 0x4f," line20="        &quot;4&quot;: 0x66," line21="        &quot;5&quot;: 0x6d," line22="        &quot;6&quot;: 0x7d," line23="        &quot;7&quot;: 0x07," line24="        &quot;8&quot;: 0x7f," line25="        &quot;9&quot;: 0x6f," line26="        &quot;A&quot;: 0x77," line27="        &quot;B&quot;: 0x7c," line28="        &quot;C&quot;: 0x39," line29="        &quot;D&quot;: 0x5e," line30="        &quot;E&quot;: 0x79," line31="        &quot;F&quot;: 0x71," line32="        &quot;G&quot;: 0x3d," line33="        &quot;H&quot;: 0x76," line34="        &quot;I&quot;: 0x06," line35="        &quot;J&quot;: 0x1e," line36="        &quot;L&quot;: 0x38," line37="        &quot;N&quot;: 0x54," line38="        &quot;O&quot;: 0x3f," line39="        &quot;P&quot;: 0x73," line40="        &quot;Q&quot;: 0x67," line41="        &quot;R&quot;: 0x50," line42="        &quot;S&quot;: 0x6d," line43="        &quot;T&quot;: 0x78," line44="        &quot;U&quot;: 0x3e," line45="        &quot;Y&quot;: 0x6e," line46="        &quot;Z&quot;: 0x5b," line47="        &quot; &quot;: 0x00," line48="        &quot;-&quot;: 0x40" line49="    }" line50="" line51="    export enum one_through_eight {" line52="        //%block=&quot;1&quot;" line53="        Digit1 = 1," line54="        //%block=&quot;2&quot;" line55="        Digit2 = 2," line56="        //%block=&quot;3&quot;" line57="        Digit3 = 3," line58="        //%block=&quot;4&quot;" line59="        Digit4 = 4," line60="        //%block=&quot;5&quot;" line61="        Digit5 = 5," line62="        //%block=&quot;6&quot;" line63="        Digit6 = 6," line64="        //%block=&quot;7&quot;" line65="        Digit7 = 7," line66="        //%block=&quot;8&quot;" line67="        Digit8 = 8" line68="    }" line69="" line70="    export enum PinOptions {" line71="        //% block=&quot;P0=STB, P1=CLK, P2=DIO&quot;" line72="        Default," line73="        //% block=&quot;P16=STB, P15=CLK, P14=DIO&quot;" line74="        AlternateOne," line75="        //% block=&quot;P16=STB, P8=CLK, P2=DIO&quot;" line76="        AlternateTwo," line77="        //% block=&quot;P16=STB, P8=CLK, P1=DIO&quot;" line78="        AlternateThree," line79="        //% block=&quot;P16=STB, P8=CLK, P0=DIO&quot;" line80="        AlternateFour" line81="    }" line82="" line83="    /**" line84="     * Converts input char to corresponding seven segment " line85="     * binary value, if the character is not found in the" line86="     * table such as &quot;M&quot; or &quot;X&quot;, the function will return as empty " line87="     * space (svn segment off). This is because some characters" line88="     * such as &quot;M&quot; and &quot;X&quot; cannot be represented in a seven" line89="     * segment display." line90="     */" line91="    function seven_segment_decoder(c: string): number {" line92="        if (seven_segment_decoder_table[c] != undefined) {" line93="            return seven_segment_decoder_table[c]" line94="        } else {" line95="            return 0x00" line96="        }" line97="    }" line98="" line99="    /* " line100="     * Replicates Arduino shiftOut function (with MSBFIRST option removed)," line101="     * sends out 8-bit number one bit at a time starting with the" line102="     * least significant bit" line103="     */" line104="    function shiftOut(dataPin: DigitalPin, clockPin: DigitalPin, value: number): void {" line105="        let bit: number" line106="" line107="        // loop through all 8 bits" line108="        for (let i = 0; i &lt; 8; i++) {" line109="" line110="            // right shift value by current bit" line111="            // being sent (determined by loop index)" line112="            // this places the bit that is being send in the " line113="            // LSB, then AND with binary 00000001 to mask" line114="            // out all other bits " line115="            bit = (value &gt;&gt; i) &amp; 0b1" line116="" line117="            pins.digitalWritePin(dataPin, bit)" line118="            pins.digitalWritePin(clockPin, 1)" line119="            pins.digitalWritePin(clockPin, 0)" line120="        }" line121="    }" line122="" line123="    /* " line124="     * Replicates Arduino shiftIn function (with MSBFIRST option removed)," line125="     * reads in 8-bit number one bit at a time starting with the" line126="     * least significant bit" line127="     */" line128="    function shiftIn(dataPin: DigitalPin, clockPin: DigitalPin): number {" line129="        let value = 0" line130="        for (let j = 0; j &lt; 8; j++) {" line131="            pins.digitalWritePin(clockPin, 1)" line132="" line133="            // shift read in bit status to the index " line134="            // of the current bit being read LSB first" line135="            // OR with other bits " line136="            value |= (pins.digitalReadPin(dataPin) &lt;&lt; j)" line137="            pins.digitalWritePin(clockPin, 0)" line138="        }" line139="        return value" line140="    }" line141="" line142="    /* " line143="     * Manufacturer provided method of sending a command to the TM1638" line144="     */" line145="    function sendCommand(cmd: number): void {" line146="        pins.digitalWritePin(strobe, 0)" line147="        shiftOut(data, clock, cmd)" line148="        pins.digitalWritePin(strobe, 1)" line149="    }" line150="" line151="    /* " line152="     * Manufacturer provided method of reading button status" line153="     */" line154="    function read_buttons(): number {" line155="        let buttons = 0" line156="        pins.digitalWritePin(strobe, 0)" line157="        shiftOut(data, clock, 0x42)" line158="" line159="        pins.setPull(data, PinPullMode.PullNone)" line160="" line161="        for (let k = 0; k &lt; 4; k++) {" line162="            let v = shiftIn(data, clock) &lt;&lt; k" line163="            buttons |= v" line164="        }" line165="" line166="        pins.digitalWritePin(strobe, 1)" line167="        return buttons" line168="    }" line169="" line170="    /**" line171="     * Allows the user to show a string on the 7-segment display " line172="     */" line173="    //%block weight=7" line174="    export function showString(input_text: string): void {" line175="        input_text = input_text.toUpperCase()" line176="        seven_segment_status = [0, 0, 0, 0, 0, 0, 0, 0]" line177="" line178="        // if the input string is above 8 chars in length, truncate down to 8 chars" line179="        if (input_text.length &gt; 8) {" line180="            input_text = input_text.slice(0, 8)" line181="        }" line182="" line183="        // loop through all inputted characters" line184="        for (let l = 0; l &lt; input_text.length; l++) {" line185="" line186="            // call decoder function to recieve the seven segment binary for" line187="            // the current letter" line188="            seven_segment_status[l] = seven_segment_decoder(input_text.charAt(l))" line189="" line190="        }" line191="" line192="        // display the sanitized input text on the seven segment displays" line193="        update_seven_segments()" line194="    }" line195="" line196="    /**" line197="     * Allows the user to set the status of the 8 LEDs" line198="     */" line199="    //% block=&quot;turn ON/OFF LEDs $txt LED1 =$led0 LED2 =$led1 LED3 =$led2 LED4 =$led3 LED5 =$led4 LED6 =$led5 LED7 =$led6 LED8 =$led7&quot;" line200="    //% txt.shadow=&quot;&quot; led0.shadow=&quot;toggleOnOff&quot; led1.shadow=&quot;toggleOnOff&quot; led2.shadow=&quot;toggleOnOff&quot; led3.shadow=&quot;toggleOnOff&quot;" line201="    //% led4.shadow=&quot;toggleOnOff&quot; led5.shadow=&quot;toggleOnOff&quot; led6.shadow=&quot;toggleOnOff&quot; led7.shadow=&quot;toggleOnOff&quot;" line202="    //% led0.defl=false led1.defl=false led2.defl=false led3.defl=false" line203="    //% led4.defl=false led5.defl=false led6.defl=false led7.defl=false" line204="    //% weight=5" line205="    export function setLEDs(" line206="        led0: boolean, led1: boolean, led2: boolean, led3: boolean," line207="        led4: boolean, led5: boolean, led6: boolean, led7: boolean" line208="    ): void {" line209="        led_status = [led0, led1, led2, led3, led4, led5, led6, led7]" line210="        update_LEDs()" line211="    }" line212="" line213="    /* " line214="     * Manufacturer provided method of reading button status" line215="     * modified to loop through a list of led status instead" line216="     * of setting an individual led at specified position" line217="     */" line218="    function update_LEDs(): void {" line219="" line220="        // loop through all 8 LEDs in led_status list" line221="        for (let m = 0; m &lt; 8; m++) {" line222="" line223="            shiftOut(data, clock, 0x44)" line224="            pins.digitalWritePin(strobe, 0)" line225="" line226="            // convert boolean to 1 or 0" line227="            // for current led" line228="            let led_state: number" line229="            if (led_status[m]) {" line230="                led_state = 1" line231="            } else {" line232="                led_state = 0" line233="            }" line234="" line235="            pins.digitalWritePin(strobe, 0)" line236="            shiftOut(data, clock, 0xC1 + (m &lt;&lt; 1))" line237="            shiftOut(data, clock, led_state)" line238="            pins.digitalWritePin(strobe, 1)" line239="        }" line240="    }" line241="" line242="    /* " line243="     * Manufacturer provided method of writing to seven segment displays" line244="     */" line245="    function update_seven_segments(): void {" line246="" line247="        pins.digitalWritePin(strobe, 0)" line248="        shiftOut(data, clock, 0x40)" line249="        pins.digitalWritePin(strobe, 1)" line250="" line251="        pins.digitalWritePin(strobe, 0)" line252="        shiftOut(data, clock, 0xC0)" line253="" line254="        for (let n = 0; n &lt; 8; n++) {" line255="" line256="            shiftOut(data, clock, seven_segment_status[n])" line257="            shiftOut(data, clock, led_status[n] ? 1 : 0)" line258="        }" line259="" line260="        pins.digitalWritePin(strobe, 1)" line261="    }" line262="" line263="    /* " line264="     * Manufacturer provided method of resetting the board" line265="     */" line266="    //% block=&quot;clear board&quot; weight=8" line267="    export function reset(): void {" line268="        sendCommand(0x40)" line269="        pins.digitalWritePin(strobe, 0)" line270="        shiftOut(data, clock, 0xC0)" line271="        for (let o = 0; o &lt; 16; o++) {" line272="            shiftOut(data, clock, 0x00)" line273="        }" line274="        pins.digitalWritePin(strobe, 1)" line275="" line276="        led_status = [false, false, false, false, false, false, false, false]" line277="        update_LEDs()" line278="    }" line279="" line280="    /* " line281="     * Manufacturer provided method of board setup" line282="     */" line283="    function setup(): void {" line284="        sendCommand(0x8F)" line285="        reset()" line286="    }" line287="" line288="    /**" line289="     * Allows the user to scroll through text." line290="     * Text can be any length so the user can display more than" line291="     * 8 characters" line292="     */" line293="    //% block=&quot;scroll text %text with speed %speed&quot; weight=6" line294="    //% speed.min=1 speed.max=10 speed.defl=5" line295="    export function scrollText(text: string, speed: number): void {" line296="" line297="        text = text.toUpperCase()" line298="" line299="        // convert 1 through 10 for input speed to a delay in ms" line300="        // start with 350 initial delay, subtract the 1-10 speed" line301="        // after scaling it to ms, each increase of speed value" line302="        // decreases the delay by 30 ms" line303="        let delay = 350 - (speed * 30)" line304="" line305="        // add spaces before and after the text" line306="        let padded_text = &quot;        &quot; + text + &quot;        &quot;" line307="" line308="        // loop through each 8-character slice in the padded_text" line309="        for (let p = 0; p &lt;= padded_text.length - 8; p++) {" line310="" line311="            // get the current 8-char text from the padded text" line312="            let current_text = padded_text.slice(p, p + 8)" line313="" line314="            // call existing show string function and" line315="            // delay for specified time before showing the" line316="            // next 8-char slice" line317="            showString(current_text)" line318="            basic.pause(delay)" line319="        }" line320="    }" line321="" line322="    /**" line323="     * Allows the user to enable the decimal point on a " line324="     * specific seven segment display (1 through 8)" line325="     */" line326="    //%block=&quot;turn decimal point $state at digit %digit&quot; weight=4" line327="    //% digit.defl=TM1638.one_through_eight.Digit1" line328="    //% state.shadow=&quot;toggleOnOff&quot; state.defl=true" line329="    export function setDecimalPoint(digit: one_through_eight, state: boolean): void {" line330="        let index = digit - 1" line331="" line332="        // decimal point is controlled by the 7th bit" line333="        // so a seven segment binary of 0x80=0b10000000" line334="        // will enable the decimal point" line335="        if (state) {" line336="            seven_segment_status[index] |= 0x80" line337="        } else {" line338="            // to clear the decimal point, AND" line339="            // with the inverse of 0b10000000" line340="            // to maintain all other bits but clear the decimal bit" line341="            seven_segment_status[index] &amp;= ~0x80" line342="        }" line343="" line344="        update_seven_segments()" line345="    }" line346="" line347="" line348="    /**" line349="     * Allows the user to start polling the button status" line350="     * User can select between 4 different polling rates" line351="     * which dictates generally how long the user must" line352="     * press and hold a button for an positive press reading" line353="     */" line354="    //% block=&quot;start checking buttons&quot; weight=3" line355="    export function startCheckingButtons(): void {" line356="" line357="        // if the buttons are already being checked and the" line358="        // function is called again, return to avoid two" line359="        // background subroutines" line360="        if (monitor_buttons_enable) return" line361="" line362="        // function was called while the buttons were not being " line363="        // checked so enable this flag to start checking the buttons" line364="        monitor_buttons_enable = true" line365="" line366="        // run in background block" line367="        control.inBackground(() =&gt; {" line368="" line369="            while (monitor_buttons_enable) {" line370="" line371="                // call function to get current button status" line372="                let current = read_buttons()" line373="" line374="                // loop through all 8 bits of current" line375="                // each bit represents the corresponding button status" line376="                for (let q = 0; q &lt; 8; q++) {" line377="" line378="                    // set all bits to 0 except current bit being checked" line379="                    let mask = 1 &lt;&lt; q" line380="" line381="                    // check that current button is pressed," line382="                    // ensure that the button state has changed since last recorded status " line383="                    // (otherwise holding the button would count as multiple presses)" line384="                    if ((current &amp; mask) &amp;&amp; !(lastButtonState &amp; mask)) {" line385="" line386="                        // check if the user has created a " line387="                        // function block for the current button that was pressed" line388="                        if (button_functions[q]) {" line389="" line390="                            // if the user has created the function block, call the function" line391="                            button_functions[q](q + 1)" line392="                        }" line393="                    }" line394="                }" line395="" line396="                // save the current button states and delay for specified time" line397="                lastButtonState = current" line398="                basic.pause(button_poll_rate)" line399="            }" line400="        })" line401="    }" line402="" line403="    /*" line404="     * Allows the user to disable polling buttons" line405="     * Frees up TM1638 board I/O for other uses" line406="     */" line407="    //% block=&quot;stop checking buttons&quot; weight=1" line408="    export function stopCheckingButtons(): void {" line409="        monitor_buttons_enable = false" line410="    }" line411="" line412="    /*" line413="     * Allows the user to execute a function when a specific button" line414="     * is pressed" line415="     */" line416="    //% block=&quot;on button %btn pressed&quot; weight=2" line417="    //% btn.defl=TM1638.one_through_eight.Digit1" line418="    export function onButtonPressed(btn: one_through_eight, button_function: () =&gt; void): void {" line419="" line420="        // adds a reference to a function to button_functions as a list element" line421="        // with index corresponding to the button number" line422="        // ie. button 1 will call function in index position 0," line423="        // button 8 will call function in index position 7 " line424="        button_functions[btn - 1] = button_function" line425="    }" line426="" line427="    /**" line428="     * Allows the user to choose between using P0,P1, and P2" line429="     * or P16, P15, and P14" line430="     */" line431="    //% block=&quot;use pins %pins&quot; weight=10" line432="    export function choosePinOption(pins: PinOptions): void {" line433="        if (pins == PinOptions.Default) {" line434="            strobe = DigitalPin.P0" line435="            clock = DigitalPin.P1" line436="            data = DigitalPin.P2" line437="        } else if (pins == PinOptions.AlternateOne) {" line438="            strobe = DigitalPin.P16" line439="            clock = DigitalPin.P15" line440="            data = DigitalPin.P14" line441="        }" line442="        else if (pins == PinOptions.AlternateTwo) {" line443="            strobe = DigitalPin.P16" line444="            clock = DigitalPin.P8" line445="            data = DigitalPin.P2" line446="        }" line447="        else if (pins == PinOptions.AlternateThree) {" line448="            strobe = DigitalPin.P16" line449="            clock = DigitalPin.P8" line450="            data = DigitalPin.P1" line451="        }" line452="        else {" line453="            strobe = DigitalPin.P16" line454="            clock = DigitalPin.P8" line455="            data = DigitalPin.P0" line456="        }" line457="" line458="        initialize()" line459="    }" line460="" line461="    /*" line462="     * Allows the user to set the brightness of the board" line463="     */ " line464="    //% block=&quot;set brightness to %level&quot; weight=9" line465="    //% level.min=0 level.max=7" line466="    export function setBrightness(level: number): void {" line467="        sendCommand(0x88 | level)" line468="    }" line469="" line470="    /*" line471="     * Must be placed before trying to use any other block" line472="     * ideally place in &quot;on start&quot;" line473="     */" line474="    //%block=&quot;initialize&quot; weight=11" line475="    export function initialize(): void {" line476="        basic.pause(50)" line477="        setup()" line478="        basic.pause(100)" line479="    }" line480="" line481="}" numlines="482"></mutation></block></statement></block></xml>